{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tutien",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/api/*"] },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tutien-db",
      "database_id": "03981595-7a9e-493c-ac75-852da410f4c8",
      "migrations_dir": "migrations"
    }
  ],
  // Luận đạo trực tiếp: một phòng ghép cặp toàn cục + mỗi trận một phòng đấu
  "durable_objects": {
    "bindings": [
      { "name": "MATCHMAKER", "class_name": "Matchmaker" },
      { "name": "DUEL_ROOM", "class_name": "DuelRoom" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Matchmaker", "DuelRoom"] }],
  // Dọn tài khoản khách bỏ hoang mỗi ngày lúc 3h sáng (UTC)
  "triggers": { "crons": ["0 3 * * *"] },
  "vars": {
    "BETTER_AUTH_URL": "https://tutien.nghia-code.workers.dev", // local ghi đè trong .dev.vars
    // "1" = hiện nhãn "Tàn ảnh" cho đối thủ là bot; "0" = bot trông như người thật
    "DUEL_BOT_LABEL": "0"
  }
}
